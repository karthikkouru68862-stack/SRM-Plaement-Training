n=int(input())
for i in range(n):
    a,b=input().split()
    r1=1
    r2=1
    for j in a:
        if j=='X':
            r1=r1*10
        elif j=='L':
            r1=r1*5
        elif j=='M':
            r1=r1*2
        elif j=='S':
            r1=r1* -1
    for j in b:
        if j=='X':
            r2=r2*10
        elif j=='L':
            r2=r2*5
        elif j=='M':
            r2=r2*2
        elif j=='S':
            r2=r2* -1
    if r1<r2:
        print("<")
    elif r1>r2:
        print(">")
    else:
        print("=")
          
            
            
            
            
            
